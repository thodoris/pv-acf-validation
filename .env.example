# Firebase Web SDK config — copy to .env.local and fill in.
# Values are public (per Firebase's design); access control is via Firestore rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Admin Google account email. Must match the email used by the Firestore
# `read` security rule. Shown to the admin after sign-in; if a different
# account signs in, the AdminPanel renders "Not authorized".
VITE_ADMIN_EMAIL=

# Firebase App Check — reCAPTCHA v3 site key (public). Registered in
# Firebase Console → App Check. Tokens are sent on every Firestore/Auth
# request; enforcement is toggled separately in Console. If unset, the
# client falls back to no App Check (build still succeeds).
VITE_FIREBASE_APPCHECK_SITE_KEY=
