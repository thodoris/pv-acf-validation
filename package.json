{
  "name": "pv-acf-expert-validation",
  "version": "0.1.0",
  "description": "PV-ACF Expert Validation Platform — guided single-session expert review for the PV-ACF doctoral thesis framework.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "start:review": "vite --open \"/?tweaks=1\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --open",
    "preview:review": "vite preview --open \"/?tweaks=1\"",
    "view": "npm run build && npm run preview",
    "view:review": "npm run build && npm run preview:review",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^2.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
